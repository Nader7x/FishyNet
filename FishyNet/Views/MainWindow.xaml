<Window x:Class="FishyNet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FishyNet.Controls"
        xmlns:vm="clr-namespace:FishyNet.ViewModels"
        Title="FishyNet — High-Performance LAN Bandwidth Shaper &amp; Telemetry"
        Width="1440"
        Height="860"
        MinWidth="1100"
        MinHeight="660"
        Background="{StaticResource CanvasBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource SansFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource CanvasBgBrush}">
        <Grid.RowDefinitions>
            <!-- 0: Hardware Title & Master Command Ribbon -->
            <RowDefinition Height="38" />
            <!-- 1: Filter & Secondary Action Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Primary Split Workspace (Master DataGrid + Collapsible Dock + Inspector) -->
            <RowDefinition Height="*" />
            <!-- 3: Bottom Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- =========================================================================
             ROW 0: HARDWARE TITLE & MASTER COMMAND RIBBON (HEIGHT 38)
             High draggable surface area: identity, NIC, primary telemetry, core actions
             ========================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBgBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand & Version -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Hardware NIC Selector -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Inline Real-time Telemetry with Hairlines -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Primary Control Actions -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Draggable Caption Space -->
                    <ColumnDefinition Width="*" />
                    <!-- Window Controls (Min, Max, Close) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="3" Margin="0,0,8,0">
                        <Image x:Name="BrandLogoImage" Width="18" Height="18" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Text="FISHYNET" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Hardware NIC Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,16,0">
                    <TextBlock Text="NIC:" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Adapters}"
                              SelectedItem="{Binding SelectedAdapter}"
                              Height="25"
                              Width="180"
                              FontSize="11">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="105" />
                                    <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding LocalIp}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentSkyBrush}" FontWeight="Bold" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Inline Real-time Hardware Telemetry (Instantaneous Metrics) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Rectangle Width="1" Height="18" Fill="{StaticResource BorderSubtleBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="RX " FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalDownloadText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <TextBlock Text="TX " FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalUploadText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <Rectangle Width="1" Height="18" Fill="{StaticResource BorderSubtleBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="RTT " FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GatewayLatencyText}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="18" Fill="{StaticResource BorderSubtleBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Primary Master Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0">
                    <Button Content="SCAN"
                            Command="{Binding ScanSubnetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="25"
                            Padding="10,2"
                            FontSize="11"
                            FontFamily="{StaticResource MonoFont}"
                            Margin="0,0,5,0"
                            ToolTip="Broadcast ARP probe queries across active subnet" />

                    <Button Content="{Binding RedirectionButtonText}"
                            Command="{Binding ToggleRedirectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="25"
                            Padding="12,2"
                            FontSize="11"
                            FontFamily="{StaticResource MonoFont}"
                            Margin="0,0,5,0"
                            ToolTip="Toggle live ARP redirection and rate regulation" />

                    <Button Command="{Binding ToggleGamingBoostCommand}"
                            Height="25"
                            Padding="10,2"
                            FontSize="11"
                            FontFamily="{StaticResource MonoFont}"
                            FontWeight="Bold"
                            ToolTip="Enforce immediate 64 KB/s throttle on all background hosts to secure gaming RTT">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentSkyBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentSkyBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGamingBoostActive}" Value="True">
                                        <Setter Property="Background" Value="#3B230B" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                        <Setter Property="Foreground" Value="#FEF08A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding GamingBoostButtonText}" />
                    </Button>
                </StackPanel>

                <!-- Column 4 is empty, providing generous natural drag area for the WindowChrome -->

                <!-- Window Control Buttons (Native Windows 10 Vector Chrome) -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Command="{Binding MinimizeWindowCommand}"
                            Style="{StaticResource WindowChromeButtonStyle}"
                            ToolTip="Minimize">
                        <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" />
                    </Button>
                    <Button Command="{Binding MaximizeWindowCommand}"
                            Style="{StaticResource WindowChromeButtonStyle}"
                            ToolTip="Maximize / Restore">
                        <Path Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" />
                    </Button>
                    <Button Command="{Binding CloseWindowCommand}"
                            Style="{StaticResource WindowChromeCloseButtonStyle}"
                            ToolTip="Close">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================================================================
             ROW 1: FILTER & SECONDARY ACTION TOOLBAR (HEIGHT AUTO)
             Hosts, search, filters, presets, and secondary tool shortcuts
             ========================================================================= -->
        <Border Grid.Row="1"
                Background="{StaticResource SubtleBgBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search Input -->
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <!-- Status Filter Tags -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <!-- Rate Limit Presets -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Discovered Hosts Counter -->
                    <ColumnDefinition Width="*" />
                    <!-- Secondary Utilities & Export -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource MonoFont}"
                         ToolTip="Filter hosts by Display Name, IPv4, MAC, or OUI Vendor" />

                <!-- Status Filter Tags -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FILTER:" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="ALL" Command="{Binding SetStatusFilterCommand}" CommandParameter="All" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="8,2" FontSize="11" Margin="0,0,3,0" />
                    <Button Content="ACTIVE" Command="{Binding SetStatusFilterCommand}" CommandParameter="Active" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="8,2" FontSize="11" Margin="0,0,3,0" />
                    <Button Content="THROTTLED" Command="{Binding SetStatusFilterCommand}" CommandParameter="Throttled" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="8,2" FontSize="11" Margin="0,0,3,0" />
                    <Button Content="BLOCKED" Command="{Binding SetStatusFilterCommand}" CommandParameter="Blocked" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="8,2" FontSize="11" Margin="0,0,3,0" />
                    <Button Content="BYPASSED" Command="{Binding SetStatusFilterCommand}" CommandParameter="Bypassed" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="8,2" FontSize="11" />
                </StackPanel>

                <!-- Rate Limit Presets Selector -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PRESET:" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Command="{Binding DataContext.ApplyPresetToAllLanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="24"
                                        Padding="8,2"
                                        FontSize="11"
                                        FontFamily="{StaticResource MonoFont}"
                                        Margin="0,0,3,0"
                                        ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Discovered Hosts Counter -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                    <TextBlock Text="HOSTS: " FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding OnlineDevicesCount}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text=" · THROTTLED: " FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ThrottledDevicesCount}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" />
                    <TextBlock Text=" · BLOCKED: " FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding BlockedDevicesCount}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCrimsonBrush}" />
                </StackPanel>

                <!-- Secondary Utilities & Actions -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="MINI HUD"
                            Command="{Binding ToggleMiniHudCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="24"
                            Padding="8,2"
                            FontSize="11"
                            FontFamily="{StaticResource MonoFont}"
                            Margin="0,0,5,0"
                            ToolTip="Toggle lightweight desktop gaming overlay widget" />

                    <Button Content="{Binding UnitModeButtonText}"
                            Command="{Binding ToggleUnitModeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="24"
                            Padding="8,2"
                            FontSize="11"
                            FontFamily="{StaticResource MonoFont}"
                            Margin="0,0,5,0"
                            ToolTip="Toggle throughput format between Bytes/sec (KB/s) and ISP Bits/sec (Kbps)" />

                    <Button Content="INSPECT"
                            Command="{Binding ToggleInspectorCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="24"
                            Padding="8,2"
                            FontSize="11"
                            FontFamily="{StaticResource MonoFont}"
                            Margin="0,0,5,0"
                            ToolTip="Toggle right-side hardware device inspector drawer" />

                    <Button Content="EXPORT CSV"
                            Command="{Binding ExportDevicesCsvCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="24"
                            Padding="8,2"
                            FontSize="11"
                            FontFamily="{StaticResource MonoFont}"
                            Margin="0,0,10,0"
                            ToolTip="Export current device telemetry ledger to CSV" />

                    <CheckBox Content="TRAY"
                              IsChecked="{Binding CloseToTray}"
                              VerticalAlignment="Center"
                              FontSize="11"
                              FontFamily="{StaticResource MonoFont}"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              ToolTip="Keep packet shaper running in system tray on window close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================================================================
             ROW 2: PRIMARY SPLIT WORKSPACE
             Column 0: Master Device DataGrid + Collapsible Bottom Dock
             Column 1: Collapsible Right-Side Device Inspector Drawer
             ========================================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Main Master Viewport & Dock -->
                <ColumnDefinition Width="*" />
                <!-- Collapsible Inspector Drawer -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Split Grid (Upper: Master DataGrid, Lower: Bottom Instrument Dock) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Upper Master Viewport: Virtualized Device DataGrid (Primary Top 65%) -->
                    <RowDefinition Height="3*" MinHeight="160" />
                    <!-- GridSplitter Divider -->
                    <RowDefinition Height="4" />
                    <!-- Lower Collapsible Instrument Dock (Bottom 35%) -->
                    <RowDefinition Height="2*" MinHeight="130" />
                </Grid.RowDefinitions>

                <!-- UPPER: VIRTUALIZED HIGH-DENSITY MASTER DATAGRID -->
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding FilteredDevices}"
                          SelectedItem="{Binding SelectedDevice}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          RowHeight="36"
                        GridLinesVisibility="All">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Toggle Monitored / Bypassed State" Command="{Binding ToggleMonitoredCommand}" FontWeight="Bold" />
                                        <MenuItem Header="Set Monitored (Redirect via Npcap)" Command="{Binding MonitorDeviceCommand}" />
                                        <MenuItem Header="Set Bypassed (Direct to Gateway)" Command="{Binding BypassDeviceCommand}" />
                                        <Separator />
                                        <MenuItem Header="Clear Caps &amp; Restore Full Speed" Command="{Binding ClearCapsCommand}" />
                                        <MenuItem Header="Send Wake-on-LAN (WoL) Packet" Command="{Binding DataContext.WakeSelectedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Separator />
                                        <MenuItem Header="Copy IPv4 Address" Command="{Binding CopyIpCommand}" />
                                        <MenuItem Header="Copy MAC Address" Command="{Binding CopyMacCommand}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Interactive Status Button -->
                        <DataGridTemplateColumn Header="STATE" Width="94" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding ToggleMonitoredCommand}"
                                            Cursor="Hand"
                                            ToolTip="Click to toggle between MONITORED (redirected) and BYPASSED (direct to gateway)"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{StaticResource CanvasBgBrush}"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding StatusBadgeText}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding StatusColorHex}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Host & OUI Vendor -->
                        <DataGridTemplateColumn Header="HOST / OUI VENDOR" Width="1.4*" MinWidth="150" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                        <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Vendor}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- IPv4 / MAC -->
                        <DataGridTemplateColumn Header="IPV4 / MAC" Width="148" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IpAddressText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding MacAddressText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- RX Speed + Bar -->
                        <DataGridTemplateColumn Header="RX RATE" Width="1.1*" MinWidth="115" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="2,0">
                                        <Grid>
                                            <TextBlock Text="{Binding DownloadSpeedText}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" />
                                            <TextBlock Text="{Binding DownloadCapStatusText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <ProgressBar Value="{Binding DownloadBarRatio, Mode=OneWay}"
                                                     Minimum="0" Maximum="1"
                                                     Height="3.5"
                                                     Margin="0,3,0,0"
                                                     Foreground="{StaticResource AccentSkyBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- TX Speed + Bar -->
                        <DataGridTemplateColumn Header="TX RATE" Width="1.1*" MinWidth="115" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="2,0">
                                        <Grid>
                                            <TextBlock Text="{Binding UploadSpeedText}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" />
                                            <TextBlock Text="{Binding UploadCapStatusText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <ProgressBar Value="{Binding UploadBarRatio, Mode=OneWay}"
                                                     Minimum="0" Maximum="1"
                                                     Height="3.5"
                                                     Margin="0,3,0,0"
                                                     Foreground="{StaticResource AccentVioletBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 30s Sparkline Trend -->
                        <DataGridTemplateColumn Header="30s TREND" Width="80" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:SparklineControl PrimarySeries="{Binding SparklineSeries}" Height="22" Margin="1,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Inline Download Cap (KB/s) -->
                        <DataGridTemplateColumn Header="RX CAP" Width="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DownloadCapKBps, UpdateSourceTrigger=LostFocus}"
                                             KeyDown="CapTextBox_KeyDown"
                                             IsEnabled="{Binding CanThrottle}"
                                             Style="{StaticResource DarkTextBoxStyle}"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="12"
                                             Padding="4,2"
                                             TextAlignment="Right"
                                             ToolTip="Download cap in KB/s (0 = Unlimited)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Inline Upload Cap (KB/s) -->
                        <DataGridTemplateColumn Header="TX CAP" Width="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UploadCapKBps, UpdateSourceTrigger=LostFocus}"
                                             KeyDown="CapTextBox_KeyDown"
                                             IsEnabled="{Binding CanThrottle}"
                                             Style="{StaticResource DarkTextBoxStyle}"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="12"
                                             Padding="4,2"
                                             TextAlignment="Right"
                                             ToolTip="Upload cap in KB/s (0 = Unlimited)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 7D / 30D Usage -->
                        <DataGridTemplateColumn Header="USAGE" Width="105" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WeekUsageText, StringFormat='7D: {0}'}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding MonthUsageText, StringFormat='30D: {0}'}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ping Latency -->
                        <DataGridTextColumn Header="PING"
                                            Binding="{Binding PingLatencyText}"
                                            Width="58"
                                            FontFamily="{StaticResource MonoFont}"
                                            FontSize="12"
                                            IsReadOnly="True" />

                        <!-- Kill-Switch Block -->
                        <DataGridTemplateColumn Header="BLOCK" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanThrottle}"
                                              ToolTip="Kill-Switch: Drop all packets for this host"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 1px Hardware GridSplitter -->
                <GridSplitter Grid.Row="1"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="{StaticResource BorderSubtleBrush}"
                              ResizeDirection="Rows"
                              ShowsPreview="False" />

                <!-- LOWER: COLLAPSIBLE BOTTOM INSTRUMENT DOCK (TABBED HARDWARE PANELS) -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBgBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <TabControl SelectedIndex="{Binding ActiveWorkspaceTab}">

                        <!-- TAB 0: LIVE DNS SINKHOLE -->
                        <TabItem Header="LIVE DNS SINKHOLE">
                            <Grid Margin="6,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                 <!-- Strip Controls -->
                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <TextBlock Text="LIVE PER-DEVICE DNS AUDIT STREAM" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="BLOCK DOMAIN"
                                                Command="{Binding BlockSelectedDnsDomainCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Height="24"
                                                Padding="8,2"
                                                FontSize="11"
                                                FontFamily="{StaticResource MonoFont}"
                                                Margin="0,0,4,0" />
                                        <Button Content="FLUSH AUDIT"
                                                Command="{Binding ClearDnsLogsCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="24"
                                                Padding="8,2"
                                                FontSize="11"
                                                FontFamily="{StaticResource MonoFont}" />
                                    </StackPanel>
                                </Grid>

                                <!-- DNS DataGrid -->
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding DnsQueryLogs}"
                                          SelectedItem="{Binding SelectedDnsRecord}"
                                          AutoGenerateColumns="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          IsReadOnly="True"
                                          RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" Width="88" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                        <DataGridTextColumn Header="DEVICE" Binding="{Binding DeviceName}" Width="160" FontWeight="SemiBold" FontSize="11" />
                                        <DataGridTextColumn Header="SOURCE IP" Binding="{Binding DeviceIp}" Width="115" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                        <DataGridTextColumn Header="QUERIED DOMAIN" Binding="{Binding Domain}" Width="*" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource AccentSkyBrush}" />
                                        <DataGridTextColumn Header="BLOCKED" Binding="{Binding WasBlocked}" Width="75" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 1: USAGE HISTORY LEDGER -->
                        <TabItem Header="USAGE HISTORY LEDGER">
                            <Grid Margin="6,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Range Selection & Aggregates -->
                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="WINDOW:" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <Button Content="TODAY (24H)" Command="{Binding SelectHistoryRangeCommand}" CommandParameter="Today" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="7,2" FontSize="11" FontFamily="{StaticResource MonoFont}" Margin="0,0,2,0" />
                                        <Button Content="PAST 7 DAYS" Command="{Binding SelectHistoryRangeCommand}" CommandParameter="Past7Days" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="7,2" FontSize="11" FontFamily="{StaticResource MonoFont}" Margin="0,0,2,0" />
                                        <Button Content="PAST 30 DAYS" Command="{Binding SelectHistoryRangeCommand}" CommandParameter="Past30Days" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="7,2" FontSize="11" FontFamily="{StaticResource MonoFont}" Margin="0,0,2,0" />
                                        <Button Content="ALL-TIME" Command="{Binding SelectHistoryRangeCommand}" CommandParameter="AllTime" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="7,2" FontSize="11" FontFamily="{StaticResource MonoFont}" Margin="0,0,10,0" />

                                        <TextBlock Text="TOTAL: " FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding HistoryGrandTotalText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="RX: " FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding HistoryTotalDownloadText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="TX: " FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding HistoryTotalUploadText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="REFRESH" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="8,2" FontSize="11" FontFamily="{StaticResource MonoFont}" Margin="0,0,4,0" />
                                        <Button Content="EXPORT CSV" Command="{Binding ExportHistoryCsvCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="8,2" FontSize="11" FontFamily="{StaticResource MonoFont}" Margin="0,0,4,0" />
                                        <Button Content="PURGE" Command="{Binding ClearHistoryCommand}" Style="{StaticResource DangerButtonStyle}" Height="24" Padding="8,2" FontSize="11" FontFamily="{StaticResource MonoFont}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Ledger Master & Bar Chart Split -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Lightweight Daily Chart -->
                                    <Border Grid.Column="0" Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="6">
                                        <controls:UsageBarChartControl Series="{Binding HistoryDailySeries}" />
                                    </Border>

                                    <!-- Historical Device Table -->
                                    <DataGrid Grid.Column="2"
                                              ItemsSource="{Binding HistoryDeviceSummaries}"
                                              AutoGenerateColumns="False"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              IsReadOnly="True"
                                              RowHeight="28">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="HOST" Binding="{Binding DisplayName}" Width="1.3*" FontWeight="SemiBold" FontSize="11" />
                                            <DataGridTextColumn Header="IPV4" Binding="{Binding IpAddressText}" Width="115" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddressText}" Width="135" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalBytesText}" Width="90" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <DataGridTextColumn Header="RX" Binding="{Binding DownloadBytesText}" Width="90" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource AccentSkyBrush}" />
                                            <DataGridTextColumn Header="TX" Binding="{Binding UploadBytesText}" Width="90" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource AccentVioletBrush}" />
                                            <DataGridTextColumn Header="LAN SHARE" Binding="{Binding LanSharePercentageText}" Width="85" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource AccentAmberBrush}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: ARP SECURITY GUARD -->
                        <TabItem Header="ARP SECURITY GUARD">
                            <Grid Margin="6,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <TextBlock Text="PASSIVE ARP MITM &amp; CACHE POISONING SHIELD" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ArpGuardStatusText}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding SecurityAlerts}"
                                          AutoGenerateColumns="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          IsReadOnly="True"
                                          RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TIME" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" Width="85" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                        <DataGridTextColumn Header="TARGET IP" Binding="{Binding TargetIp}" Width="115" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                        <DataGridTextColumn Header="EXPECTED MAC" Binding="{Binding ExpectedMac}" Width="140" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                        <DataGridTextColumn Header="OFFENDING MAC" Binding="{Binding OffendingMac}" Width="140" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource AccentCrimsonBrush}" FontWeight="Bold" />
                                        <DataGridTextColumn Header="INCIDENT DETAILS" Binding="{Binding Description}" Width="*" FontSize="11" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: PROTOCOL ANALYTICS (DPI) -->
                        <TabItem Header="PROTOCOL ANALYTICS (DPI)">
                            <Grid Margin="6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- HTTP/TLS -->
                                <Border Grid.Column="0" Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="12,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="HTTP / TLS (80, 443)" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding ProtoHttpTlsSummary}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- TCP Flows -->
                                <Border Grid.Column="2" Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="12,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="TCP FLOWS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding ProtoTcpSummary}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- UDP Datagrams -->
                                <Border Grid.Column="4" Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="12,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="UDP DATAGRAMS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding ProtoUdpSummary}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- DNS Queries -->
                                <Border Grid.Column="6" Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="12,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="DNS AUDIT (PORT 53)" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding ProtoDnsSummary}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 4: AUTONOMOUS POLICIES / SCHEDULES -->
                        <TabItem Header="AUTONOMOUS POLICIES">
                            <Grid Margin="6,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <TextBlock Text="AUTONOMOUS TIME-OF-DAY ENGINE &amp; AUTO-GAMING RULES" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                                    <Button Content="RESET RULES"
                                            Command="{Binding ResetSmartRulesCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="24"
                                            Padding="10,2"
                                            FontSize="11"
                                            FontFamily="{StaticResource MonoFont}"
                                            HorizontalAlignment="Right" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SmartRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Type Tag -->
                                                        <Border Grid.Column="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="4,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RuleType}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" HorizontalAlignment="Center" />
                                                        </Border>

                                                        <!-- Name & Description -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding StatusDescription}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <!-- Target & Cap -->
                                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="TARGET: " FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                                <TextBlock Text="{Binding TargetCategory}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="CAP: " FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                                <TextBlock Text="{Binding ThrottleCapKBps, StringFormat={}{0} KB/s}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Enable/Disable Action -->
                                                        <Button Grid.Column="6"
                                                                Command="{Binding DataContext.ToggleSmartRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Height="24"
                                                                Padding="8,2"
                                                                FontSize="11"
                                                                FontFamily="{StaticResource MonoFont}"
                                                                FontWeight="Bold">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                            <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="{Binding IsEnabled}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="ENABLED" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                <Setter Property="Text" Value="DISABLED" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Border>
            </Grid>

            <!-- Column 1: Collapsible Right-Side Device Inspector Drawer -->
            <Border Grid.Column="1"
                    Width="340"
                    Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource SubtleBgBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedDevice}">
                        <!-- Header -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="DEVICE INSPECTOR" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                            <Button Content="✕"
                                    Command="{Binding DataContext.CloseInspectorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="22"
                                    Width="22"
                                    Padding="0"
                                    FontSize="11"
                                    FontFamily="{StaticResource MonoFont}"
                                    HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="{Binding DisplayName, FallbackValue='No device selected'}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding IpAddressText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" />
                            <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding MacAddressText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Redirection Mode Buttons -->
                        <Border Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="REDIRECTION MODE" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="5,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusBadgeText}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColorHex}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="MONITOR" Command="{Binding MonitorDeviceCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="24" Padding="4,2" FontSize="11" />
                                    <Button Grid.Column="2" Content="BYPASS" Command="{Binding BypassDeviceCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="4,2" FontSize="11" />
                                </Grid>
                                <CheckBox Content="KILL-SWITCH (DROP ALL TRAFFIC)"
                                          IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanThrottle}"
                                          Foreground="{StaticResource AccentCrimsonBrush}"
                                          FontSize="11"
                                          FontFamily="{StaticResource MonoFont}"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Nickname & Category -->
                        <TextBlock Text="FRIENDLY NICKNAME" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding CustomNickname, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" FontSize="11.5" Height="25" Margin="0,0,0,6" />

                        <TextBlock Text="DEVICE CATEGORY" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding Category}"
                                  Height="26"
                                  FontSize="11.5"
                                  Margin="0,0,0,8" />

                        <!-- Data Consumption Summary -->
                        <Border Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="DATA CONSUMPTION" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,2">
                                    <TextBlock Text="SESSION:" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SessionTotalText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="TODAY:" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TodayUsageText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="7 DAYS:" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding WeekUsageText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="30 DAYS:" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding MonthUsageText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Rate Limits & Quotas -->
                        <TextBlock Text="TOKEN-BUCKET RATE LIMITS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RX (KB/s)" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding DownloadCapKBps, UpdateSourceTrigger=LostFocus}" KeyDown="CapTextBox_KeyDown" IsEnabled="{Binding CanThrottle}" Style="{StaticResource DarkTextBoxStyle}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Height="25" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TX (KB/s)" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding UploadCapKBps, UpdateSourceTrigger=LostFocus}" KeyDown="CapTextBox_KeyDown" IsEnabled="{Binding CanThrottle}" Style="{StaticResource DarkTextBoxStyle}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Height="25" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="DAILY QUOTA (MB, 0 = UNLTD)" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding DailyQuotaMB, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanThrottle}" Style="{StaticResource DarkTextBoxStyle}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Height="25" Margin="0,0,0,8" />

                        <!-- Wake-on-LAN Action -->
                        <Button Content="SEND WAKE-ON-LAN"
                                Command="{Binding DataContext.WakeSelectedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="25"
                                Padding="8,2"
                                FontSize="11"
                                FontFamily="{StaticResource MonoFont}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8" />

                        <!-- Per-Device Domain Filter -->
                        <TextBlock Text="BLOCKED DOMAINS (DNS SINKHOLE)" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding DataContext.NewDomainInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Height="25"
                                     FontSize="11.5" />
                            <Button Grid.Column="2"
                                    Content="BLOCK"
                                    Command="{Binding DataContext.AddBlockedDomainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="25"
                                    Padding="8,2"
                                    FontSize="11"
                                    FontFamily="{StaticResource MonoFont}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding BlockedDomains}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CanvasBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="6,3" Margin="0,0,0,2">
                                        <Grid>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                            <Button Content="✕"
                                                    Command="{Binding DataContext.RemoveBlockedDomainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Height="20"
                                                    Width="20"
                                                    Padding="0"
                                                    FontSize="11"
                                                    FontFamily="{StaticResource MonoFont}"
                                                    HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- =========================================================================
             ROW 3: BOTTOM HARDWARE STATUS BAR (HEIGHT 28)
             ========================================================================= -->
        <Border Grid.Row="3"
                Background="{StaticResource CanvasBgBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" Background="{StaticResource AccentEmeraldBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="14" Fill="{StaticResource BorderSubtleBrush}" Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock Text="PK " FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PeakDownloadText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="SES " FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SessionTotalText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="PACKET ENGINE: " FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding DriverStatusText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="  |  ZERO-ALLOC RING BUFFER" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>