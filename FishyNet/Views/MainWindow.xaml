<Window x:Class="FishyNet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FishyNet.Controls"
        xmlns:themes="clr-namespace:FishyNet.Themes"
        xmlns:views="clr-namespace:FishyNet.Views"
        Title="FishyNet"
        Width="1500"
        Height="900"
        MinWidth="1160"
        MinHeight="720"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackdropBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource SansFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="16"
                      CaptionHeight="42"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Compensate for Win32 resize overhang when maximized -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!-- Static HitTest-Invisible Ambient Radial Glow Layer for Layered Frosted Glass Depth -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="780"
                     Height="520"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-180,-180,0,0"
                     Opacity="0.085"
                     Fill="{DynamicResource ActiveAccentBrush}">
                <Ellipse.OpacityMask>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
            <Ellipse Width="640"
                     Height="440"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-160,-160"
                     Opacity="0.065"
                     Fill="{DynamicResource TxAccentBrush}">
                <Ellipse.OpacityMask>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
        </Grid>

        <!-- Root Application Chrome & Workspace Layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- =================================================================
                 ROW 0: DRAGGABLE FROSTED TITLEBAR + NIC + LIVE TELEMETRY + PALETTE
                 ================================================================= -->
            <Grid Grid.Row="0" Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo + Name (NO version badge next to FISHYNET, ample drag space preserved in col 1) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandLogoImage"
                           Width="20"
                           Height="20"
                           Stretch="Uniform"
                           Margin="0,0,9,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="FISHYNET"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Interactive Right Titlebar Controls -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- Network Adapter Selector -->
                    <ComboBox Width="225"
                              Height="30"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding Adapters}"
                              SelectedItem="{Binding SelectedAdapter}"
                              ToolTip="Active capture network interface">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Description}"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="112"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text=" · "
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LocalIp}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ActiveAccentBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Live Telemetry Pills -->
                    <Border Style="{StaticResource GlassPillBadgeStyle}"
                            Height="30"
                            Padding="11,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource RxAccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="RX " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalDownloadText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource RxAccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <Ellipse Width="6" Height="6" Fill="{DynamicResource TxAccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="TX " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalUploadText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TxAccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <TextBlock Text="RTT " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GatewayLatencyText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource HealthyAccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <TextBlock Text="{Binding OnlineDevicesCount}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" online"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Frosted Theme Palette Switcher -->
                    <ComboBox Width="154"
                              Height="30"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding AvailableThemePalettes}"
                              SelectedItem="{Binding SelectedThemePalette, Mode=TwoWay}"
                              ToolTip="Switch frosted acrylic theme palette">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="14"
                                            Height="14"
                                            CornerRadius="4"
                                            Margin="0,0,7,0"
                                            Background="{Binding BackdropHex, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="{DynamicResource GlassSpecularRimBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="{Binding AccentHex, Converter={StaticResource HexToBrush}}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Window Caption Controls -->
                    <Button Style="{StaticResource WindowChromeButtonStyle}"
                            Command="{Binding MinimizeWindowCommand}"
                            ToolTip="Minimize">
                        <Path Data="M 0,0 L 10,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              SnapsToDevicePixels="True" />
                    </Button>
                    <Button Style="{StaticResource WindowChromeButtonStyle}"
                            Command="{Binding MaximizeWindowCommand}"
                            ToolTip="Maximize / Restore">
                        <Path Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              SnapsToDevicePixels="True" />
                    </Button>
                    <Button Style="{StaticResource WindowChromeCloseButtonStyle}"
                            Command="{Binding CloseWindowCommand}"
                            ToolTip="Close">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- =================================================================
                 ROW 1: TOP FROSTED COMMAND RIBBON & SEGMENTED SECTION NAVIGATION
                 ================================================================= -->
            <Border Grid.Row="1"
                    Style="{StaticResource FrostedGlassCardStyle}"
                    CornerRadius="14"
                    Padding="10,7"
                    Margin="12,2,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Primary Section Segmented Navigation Bar -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GlassSegmentButtonStyle}"
                                    themes:ThemeManager.IsActive="{Binding IsLanControlSection}"
                                    Command="{Binding NavigateSectionCommand}"
                                    CommandParameter="LanControl"
                                    Content="LAN Control" />
                            <Button Style="{StaticResource GlassSegmentButtonStyle}"
                                    themes:ThemeManager.IsActive="{Binding IsAppMonitorSection}"
                                    Command="{Binding NavigateSectionCommand}"
                                    CommandParameter="AppMonitor"
                                    Margin="3,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="App &amp; Website Monitor" VerticalAlignment="Center" />
                                    <Border Margin="7,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="9"
                                            Background="{DynamicResource WarnSurfaceBrush}"
                                            BorderBrush="{DynamicResource WarnAccentBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding AppMonitor.HasUnacknowledgedAlerts, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding AppMonitor.UnacknowledgedAlertCount}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource WarnAccentBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassSegmentButtonStyle}"
                                    themes:ThemeManager.IsActive="{Binding IsTopologySecuritySection}"
                                    Command="{Binding NavigateSectionCommand}"
                                    CommandParameter="TopologySecurity"
                                    Margin="3,0,0,0"
                                    Content="Topology &amp; Security" />
                            <Button Style="{StaticResource GlassSegmentButtonStyle}"
                                    themes:ThemeManager.IsActive="{Binding IsHistoryPoliciesSection}"
                                    Command="{Binding NavigateSectionCommand}"
                                    CommandParameter="HistoryPolicies"
                                    Margin="3,0,0,0"
                                    Content="History &amp; Policies" />
                        </StackPanel>
                    </Border>

                    <!-- Global Engine & Mode Action Pills -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                themes:ThemeManager.IsActive="{Binding IsScanning}"
                                Command="{Binding ScanSubnetCommand}"
                                Margin="0,0,6,0"
                                Padding="13,6"
                                Content="SCAN"
                                ToolTip="Run active ARP subnet discovery sweep" />
                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                themes:ThemeManager.IsActive="{Binding IsRedirecting}"
                                Command="{Binding ToggleRedirectionCommand}"
                                Margin="0,0,6,0"
                                Padding="13,6"
                                Content="{Binding RedirectionButtonText}"
                                ToolTip="Start or stop Npcap packet interception and traffic shaping" />
                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                themes:ThemeManager.IsActive="{Binding IsGamingBoostActive}"
                                Command="{Binding ToggleGamingBoostCommand}"
                                Margin="0,0,6,0"
                                Padding="13,6"
                                Content="{Binding GamingBoostButtonText}"
                                ToolTip="Deprioritize background bulk LAN traffic to protect gaming ping" />
                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                themes:ThemeManager.IsActive="{Binding IsMiniHudActive}"
                                Command="{Binding ToggleMiniHudCommand}"
                                Margin="0,0,6,0"
                                Padding="13,6"
                                Content="Mini-HUD"
                                ToolTip="Toggle floating Mini-HUD overlay" />
                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                Command="{Binding ToggleUnitModeCommand}"
                                Padding="13,6"
                                Content="{Binding UnitModeButtonText}"
                                ToolTip="Switch speed readout between KB/s (MB/s) and bps (Mbps)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =================================================================
                 ROW 2: ACTIVE SECTION WORKSPACE
                 ================================================================= -->
            <Grid Grid.Row="2" Margin="12,0,12,8">

                <!-- #############################################################
                     SECTION 1: LAN CONTROL (Search + Throttle All + Grid/Bento + Floating Batch Bar + Inspector)
                     ############################################################# -->
                <Grid Visibility="{Binding IsLanControlSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Sub-row 0: Search, Status Filter Pills, View Mode Switch, Quick Counters -->
                        <Border Grid.Row="0"
                                Style="{StaticResource FrostedGlassCardStyle}"
                                CornerRadius="12"
                                Padding="10,7"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Search Input -->
                                <Grid Grid.Column="0" Width="230" Margin="0,0,10,0">
                                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10,5"
                                             VerticalContentAlignment="Center" />
                                    <TextBlock Text="Search host, IP, MAC, vendor..."
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11.5"
                                               Margin="12,0,10,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Status Filter Segmented Strip -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource ControlFillBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                                themes:ThemeManager.IsActive="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=All}"
                                                Command="{Binding SetStatusFilterCommand}"
                                                CommandParameter="All"
                                                Padding="10,3"
                                                Content="All" />
                                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                                themes:ThemeManager.IsActive="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Active}"
                                                Command="{Binding SetStatusFilterCommand}"
                                                CommandParameter="Active"
                                                Margin="3,0,0,0"
                                                Padding="10,3"
                                                Content="Active" />
                                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                                themes:ThemeManager.IsActive="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Throttled}"
                                                Command="{Binding SetStatusFilterCommand}"
                                                CommandParameter="Throttled"
                                                Margin="3,0,0,0"
                                                Padding="10,3"
                                                Content="Throttled" />
                                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                                themes:ThemeManager.IsActive="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Blocked}"
                                                Command="{Binding SetStatusFilterCommand}"
                                                CommandParameter="Blocked"
                                                Margin="3,0,0,0"
                                                Padding="10,3"
                                                Content="Blocked" />
                                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                                themes:ThemeManager.IsActive="{Binding StatusFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Bypassed}"
                                                Command="{Binding SetStatusFilterCommand}"
                                                CommandParameter="Bypassed"
                                                Margin="3,0,0,0"
                                                Padding="10,3"
                                                Content="Bypassed" />
                                    </StackPanel>
                                </Border>

                                <!-- Host Status Count Badges -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="12,0">
                                    <Border Style="{StaticResource GlassPillBadgeStyle}" Margin="0,0,6,0" Padding="9,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Online " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding OnlineDevicesCount}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HealthyAccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassPillBadgeStyle}" Margin="0,0,6,0" Padding="9,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Throttled " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding ThrottledDevicesCount}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarnAccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassPillBadgeStyle}" Padding="9,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Blocked " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding BlockedDevicesCount}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DangerAccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Table / Bento + Monitor All + Export + Inspector -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource ControlFillBrush}"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Padding="3"
                                            Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GlassChipButtonStyle}"
                                                    themes:ThemeManager.IsActive="{Binding IsTableView}"
                                                    Command="{Binding SetViewModeCommand}"
                                                    CommandParameter="Table"
                                                    Padding="9,3"
                                                    Content="Table" />
                                            <Button Style="{StaticResource GlassChipButtonStyle}"
                                                    themes:ThemeManager.IsActive="{Binding IsBentoView}"
                                                    Command="{Binding SetViewModeCommand}"
                                                    CommandParameter="Bento"
                                                    Margin="2,0,0,0"
                                                    Padding="9,3"
                                                    Content="Bento" />
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding MonitorAllCommand}"
                                            Margin="0,0,6,0"
                                            Content="Monitor All"
                                            ToolTip="Redirect all non-gateway LAN hosts through FishyNet" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding ExportDevicesCsvCommand}"
                                            Margin="0,0,6,0"
                                            Content="Export CSV" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            themes:ThemeManager.IsActive="{Binding IsInspectorOpen}"
                                            Command="{Binding ToggleInspectorCommand}"
                                            Content="Inspector" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sub-row 1: Global "Throttle All Devices" Bar -->
                        <Border Grid.Row="1"
                                Style="{StaticResource FrostedGlassCardStyle}"
                                CornerRadius="12"
                                Padding="12,8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="THROTTLE ALL DEVICES"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0"
                                            Padding="8,2"
                                            CornerRadius="9"
                                            Background="{DynamicResource WarnSurfaceBrush}"
                                            BorderBrush="{DynamicResource WarnAccentBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding IsThrottleAllActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="ACTIVE"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource WarnAccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Custom Global DL / UL Cap TextBoxes -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="DL (KB/s)"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                             Width="74"
                                             Text="{Binding ThrottleAllDownloadCapKBps, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="{StaticResource MonoFont}"
                                             HorizontalContentAlignment="Right"
                                             Padding="8,4"
                                             KeyDown="CapTextBox_KeyDown"
                                             LostFocus="CapTextBox_LostFocus"
                                             Margin="0,0,10,0" />

                                    <TextBlock Text="UL (KB/s)"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                             Width="74"
                                             Text="{Binding ThrottleAllUploadCapKBps, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="{StaticResource MonoFont}"
                                             HorizontalContentAlignment="Right"
                                             Padding="8,4"
                                             KeyDown="CapTextBox_KeyDown"
                                             LostFocus="CapTextBox_LostFocus" />
                                </StackPanel>

                                <!-- Quick Global Preset Chips -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding ApplyThrottleAllPresetCommand}"
                                            CommandParameter="256:64"
                                            Content="256K"
                                            Margin="0,0,4,0" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding ApplyThrottleAllPresetCommand}"
                                            CommandParameter="1024:256"
                                            Content="1M"
                                            Margin="0,0,4,0" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding ApplyThrottleAllPresetCommand}"
                                            CommandParameter="5120:1024"
                                            Content="5M"
                                            Margin="0,0,4,0" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding ApplyThrottleAllPresetCommand}"
                                            CommandParameter="0"
                                            Content="Unltd" />
                                </StackPanel>

                                <!-- Auto-apply checkbox -->
                                <CheckBox Grid.Column="3"
                                          IsChecked="{Binding ThrottleAllKeepAppliedToNewDevices, Mode=TwoWay}"
                                          Content="Auto-apply new devices"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          FontSize="11.5"
                                          Margin="10,0" />

                                <!-- Apply to All / Clear All -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ApplyThrottleAllCommand}"
                                            Padding="13,5"
                                            Margin="0,0,6,0"
                                            Content="Apply to All" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding ClearAllThrottlesCommand}"
                                            Padding="12,5"
                                            Content="Clear All" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sub-row 2: Device Grid / Bento Cards + Bottom-Center Floating Batch Pill -->
                        <Grid Grid.Row="2">

                            <!-- TABLE VIEW (Default) -->
                            <Border Style="{StaticResource FrostedGlassCardStyle}"
                                    CornerRadius="14"
                                    Padding="0"
                                    Visibility="{Binding IsBentoView, Converter={StaticResource InverseBoolToVis}}">
                                <Grid themes:ThemeManager.ClipCornerRadius="{StaticResource RadiusCardClipValue}">
                                    <DataGrid Style="{StaticResource FramelessDataGridStyle}"
                                              ItemsSource="{Binding FilteredDevices}"
                                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="False"
                                              RowHeight="42">
                                        <DataGrid.Resources>
                                            <ContextMenu x:Key="DeviceRowContextMenu" x:Shared="False">
                                                <MenuItem Header="Toggle Monitored / Bypassed State" Command="{Binding ToggleMonitoredCommand}" FontWeight="Bold" />
                                                <MenuItem Header="Set Monitored (Redirect via Npcap)" Command="{Binding MonitorDeviceCommand}" />
                                                <MenuItem Header="Set Bypassed (Direct to Gateway)" Command="{Binding BypassDeviceCommand}" />
                                                <Separator />
                                                <MenuItem Header="Clear Caps &amp; Restore Full Speed" Command="{Binding ClearCapsCommand}" />
                                                <MenuItem Header="Send Wake-on-LAN (WoL) Packet"
                                                          Command="{Binding PlacementTarget.Tag.WakeSelectedDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="Copy IPv4 Address" Command="{Binding CopyIpCommand}" />
                                                <MenuItem Header="Copy MAC Address" Command="{Binding CopyMacCommand}" />
                                            </ContextMenu>
                                        </DataGrid.Resources>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                <Setter Property="ContextMenu" Value="{DynamicResource DeviceRowContextMenu}" />
                                            </Style>
                                        </DataGrid.RowStyle>

                                        <DataGrid.Columns>
                                            <!-- Multi-select Checkbox Column -->
                                            <DataGridTemplateColumn Width="42" CanUserSort="False">
                                                <DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding DataContext.IsAllFilteredSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="Select or clear all throttleable devices in view" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.HeaderTemplate>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsBatchSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanThrottle}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Rounded Status Pill Badge -->
                                            <DataGridTemplateColumn Header="State" Width="114" SortMemberPath="StatusBadgeText">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding ToggleMonitoredCommand}"
                                                                Style="{StaticResource TransparentBadgeButtonStyle}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                ToolTip="{Binding MonitorModeDescription}">
                                                            <Border CornerRadius="10" Padding="10,3" MinWidth="76" BorderThickness="1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource HealthySurfaceBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource HealthyAccentBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="HOST PC">
                                                                                <Setter Property="Background" Value="{DynamicResource ActiveAccentDimBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource ActiveAccentBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="THROTTLED">
                                                                                <Setter Property="Background" Value="{DynamicResource WarnSurfaceBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarnAccentBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="BLOCKED">
                                                                                <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerAccentBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="QUOTA HIT">
                                                                                <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerAccentBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="BYPASSED">
                                                                                <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding StatusBadgeText}"
                                                                           HorizontalAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource HealthyAccentBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding StatusBadgeText}" Value="HOST PC">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource ActiveAccentBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusBadgeText}" Value="THROTTLED">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnAccentBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusBadgeText}" Value="BLOCKED">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerAccentBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusBadgeText}" Value="QUOTA HIT">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerAccentBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusBadgeText}" Value="BYPASSED">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Host / Vendor -->
                                            <DataGridTemplateColumn Header="Host / Vendor" Width="1.4*" SortMemberPath="DisplayName">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12.5"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Vendor}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- IP / MAC -->
                                            <DataGridTemplateColumn Header="IP / MAC" Width="146" SortMemberPath="IpAddressText">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding IpAddressText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding MacAddressText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- RX Rate + Bar -->
                                            <DataGridTemplateColumn Header="RX Rate" Width="128" SortMemberPath="CurrentDownloadBps">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <Grid>
                                                                <TextBlock Text="{Binding DownloadSpeedText}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource RxAccentBrush}" />
                                                                <TextBlock Text="{Binding DownloadCapStatusText}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="9.5"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Bottom" />
                                                            </Grid>
                                                            <ProgressBar Value="{Binding DownloadBarRatio, Mode=OneWay}"
                                                                         Minimum="0"
                                                                         Maximum="1"
                                                                         Height="3"
                                                                         Margin="0,4,0,0"
                                                                         Foreground="{DynamicResource RxAccentBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- TX Rate + Bar -->
                                            <DataGridTemplateColumn Header="TX Rate" Width="120" SortMemberPath="CurrentUploadBps">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <Grid>
                                                                <TextBlock Text="{Binding UploadSpeedText}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TxAccentBrush}" />
                                                                <TextBlock Text="{Binding UploadCapStatusText}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="9.5"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Bottom" />
                                                            </Grid>
                                                            <ProgressBar Value="{Binding UploadBarRatio, Mode=OneWay}"
                                                                         Minimum="0"
                                                                         Maximum="1"
                                                                         Height="3"
                                                                         Margin="0,4,0,0"
                                                                         Foreground="{DynamicResource TxAccentBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 30s Sparkline -->
                                            <DataGridTemplateColumn Header="30s Pulse" Width="92" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <controls:SparklineControl PrimarySeries="{Binding SparklineSeries}"
                                                                                   Height="24"
                                                                                   VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Inline RX Cap (KB/s) -->
                                            <DataGridTemplateColumn Header="RX Cap" Width="76" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                                                 Text="{Binding DownloadCapKBps, UpdateSourceTrigger=LostFocus}"
                                                                 IsEnabled="{Binding CanThrottle}"
                                                                 FontFamily="{StaticResource MonoFont}"
                                                                 FontSize="11.5"
                                                                 HorizontalContentAlignment="Right"
                                                                 Padding="6,3"
                                                                 KeyDown="CapTextBox_KeyDown"
                                                                 LostFocus="CapTextBox_LostFocus"
                                                                 ToolTip="Download cap in KB/s (0 = unlimited, Enter to apply)" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Inline TX Cap (KB/s) -->
                                            <DataGridTemplateColumn Header="TX Cap" Width="76" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                                                 Text="{Binding UploadCapKBps, UpdateSourceTrigger=LostFocus}"
                                                                 IsEnabled="{Binding CanThrottle}"
                                                                 FontFamily="{StaticResource MonoFont}"
                                                                 FontSize="11.5"
                                                                 HorizontalContentAlignment="Right"
                                                                 Padding="6,3"
                                                                 KeyDown="CapTextBox_KeyDown"
                                                                 LostFocus="CapTextBox_LostFocus"
                                                                 ToolTip="Upload cap in KB/s (0 = unlimited, Enter to apply)" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 7D / 30D Usage -->
                                            <DataGridTemplateColumn Header="7D / 30D" Width="104" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding WeekUsageText, StringFormat='7D: {0}'}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding MonthUsageText, StringFormat='30D: {0}'}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Ping -->
                                            <DataGridTextColumn Header="Ping"
                                                                Width="64"
                                                                IsReadOnly="True"
                                                                Binding="{Binding PingLatencyText}"
                                                                FontFamily="{StaticResource MonoFont}"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource HealthyAccentBrush}" />

                                            <!-- Block Switch -->
                                            <DataGridTemplateColumn Header="Block" Width="58" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource DangerSwitchCheckBoxStyle}"
                                                                  IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanThrottle}"
                                                                  ToolTip="Drop all packets for this device" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Inspect Button -->
                                            <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                                                Click="OnInspectDeviceClicked"
                                                                Padding="6,3"
                                                                Content="···"
                                                                ToolTip="Open Device Inspector drawer" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="Click SCAN or start REDIRECT to discover active LAN hosts."
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding FilteredDevices.Count, Converter={StaticResource CountZeroToVis}}" />
                                </Grid>
                            </Border>

                            <!-- BENTO CARD VIEW (Optional View Toggle) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsBentoView, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding FilteredDevices}" Padding="0,0,0,76">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FrostedGlassCardStyle}"
                                                    Width="300"
                                                    Margin="0,0,10,10"
                                                    Padding="12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Header: Batch CheckBox, Name, Status Badge -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsBatchSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanThrottle}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding IpAddressText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2"
                                                                Style="{StaticResource GlassPillBadgeStyle}"
                                                                Padding="7,2"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding StatusBadgeText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrush}}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Sparkline -->
                                                    <controls:SparklineControl Grid.Row="1"
                                                                               PrimarySeries="{Binding SparklineSeries}"
                                                                               Height="32"
                                                                               Margin="0,0,0,8" />

                                                    <!-- Live Speeds -->
                                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="DOWNLOAD" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding DownloadSpeedText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource RxAccentBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="UPLOAD" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding UploadSpeedText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TxAccentBrush}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Quick Caps + Block Switch + Inspect -->
                                                    <Grid Grid.Row="3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                                 Text="{Binding DownloadCapKBps, UpdateSourceTrigger=LostFocus}"
                                                                 IsEnabled="{Binding CanThrottle}"
                                                                 FontFamily="{StaticResource MonoFont}"
                                                                 FontSize="11"
                                                                 Padding="6,3"
                                                                 KeyDown="CapTextBox_KeyDown"
                                                                 LostFocus="CapTextBox_LostFocus"
                                                                 ToolTip="DL Cap (KB/s)" />
                                                        <TextBox Grid.Column="2"
                                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                                 Text="{Binding UploadCapKBps, UpdateSourceTrigger=LostFocus}"
                                                                 IsEnabled="{Binding CanThrottle}"
                                                                 FontFamily="{StaticResource MonoFont}"
                                                                 FontSize="11"
                                                                 Padding="6,3"
                                                                 KeyDown="CapTextBox_KeyDown"
                                                                 LostFocus="CapTextBox_LostFocus"
                                                                 ToolTip="UL Cap (KB/s)" />
                                                        <CheckBox Grid.Column="3"
                                                                  Style="{StaticResource DangerSwitchCheckBoxStyle}"
                                                                  IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanThrottle}"
                                                                  Margin="8,0,6,0" />
                                                        <Button Grid.Column="4"
                                                                Style="{StaticResource GlassChipButtonStyle}"
                                                                Click="OnInspectDeviceClicked"
                                                                Padding="8,3"
                                                                Content="Inspect" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- FLOATING FROSTED "BATCH THROTTLE" CAPSULE PILL (Bottom-Center Overlay) -->
                            <Border Style="{StaticResource FloatingPillBarStyle}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,14"
                                    Padding="14,8"
                                    Visibility="{Binding HasBatchSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="10"
                                            Padding="9,3"
                                            Margin="0,0,10,0"
                                            Background="{DynamicResource ActiveAccentDimBrush}"
                                            BorderBrush="{DynamicResource ActiveAccentBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedBatchCount, StringFormat='{}{0} selected'}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ActiveAccentBrush}" />
                                    </Border>

                                    <TextBlock Text="DL (KB/s)"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0" />
                                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                             Width="66"
                                             Text="{Binding BatchDownloadCapKBps, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="{StaticResource MonoFont}"
                                             HorizontalContentAlignment="Right"
                                             Padding="6,3"
                                             KeyDown="CapTextBox_KeyDown"
                                             LostFocus="CapTextBox_LostFocus"
                                             Margin="0,0,8,0" />

                                    <TextBlock Text="UL (KB/s)"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0" />
                                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                             Width="66"
                                             Text="{Binding BatchUploadCapKBps, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="{StaticResource MonoFont}"
                                             HorizontalContentAlignment="Right"
                                             Padding="6,3"
                                             KeyDown="CapTextBox_KeyDown"
                                             LostFocus="CapTextBox_LostFocus"
                                             Margin="0,0,10,0" />

                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ApplyBatchThrottleCommand}"
                                            Padding="12,4"
                                            Margin="0,0,5,0"
                                            Content="Apply Batch" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding BatchMonitorCommand}"
                                            Margin="0,0,4,0"
                                            Content="Monitor" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding BatchBypassCommand}"
                                            Margin="0,0,4,0"
                                            Content="Bypass" />
                                    <Button Style="{StaticResource DangerChipButtonStyle}"
                                            Command="{Binding BatchBlockCommand}"
                                            Margin="0,0,4,0"
                                            Content="Block" />
                                    <Button Command="{Binding BatchUnblockCommand}"
                                            Margin="0,0,4,0"
                                            Content="Unblock">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GlassChipButtonStyle}">
                                                <Setter Property="Background" Value="{DynamicResource HealthySurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource HealthyAccentBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource HealthyAccentBrush}" />
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding BatchClearCapsCommand}"
                                            Margin="0,0,4,0"
                                            Content="Clear Caps" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Command="{Binding ClearBatchSelectionCommand}"
                                            Content="Clear" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Right Collapsible Frosted Device Inspector Drawer -->
                    <Border Grid.Column="1"
                            Width="336"
                            Margin="10,0,0,0"
                            Style="{StaticResource FrostedGlassCardStyle}"
                            CornerRadius="14"
                            Padding="14"
                            Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="DEVICE INSPECTOR"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource GlassChipButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Command="{Binding CloseInspectorCommand}"
                                        Padding="8,2"
                                        Content="✕" />
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="Select any LAN host row to inspect telemetry, adjust quotas, or block domains."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="18"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding HasSelectedDevice, Converter={StaticResource InverseBoolToVis}}" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedDevice}"
                                            Visibility="{Binding DataContext.HasSelectedDevice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">

                                    <!-- Identity Header -->
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName, FallbackValue='No device selected'}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,6">
                                                <TextBlock Text="{Binding IpAddressText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ActiveAccentBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding MacAddressText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource GlassPillBadgeStyle}" Padding="8,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding StatusBadgeText}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrush}}" />
                                                </Border>
                                                <TextBlock Text="{Binding Vendor}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Actions -->
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding MonitorDeviceCommand}"
                                                        Padding="6,5"
                                                        Content="Monitor" />
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource GlassChipButtonStyle}"
                                                        Command="{Binding BypassDeviceCommand}"
                                                        Padding="6,5"
                                                        Content="Bypass" />
                                                <CheckBox Grid.Column="3"
                                                          Style="{StaticResource DangerSwitchCheckBoxStyle}"
                                                          IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanThrottle}"
                                                          Margin="8,0,0,0"
                                                          ToolTip="Block device" />
                                            </Grid>
                                            <Button Style="{StaticResource GlassChipButtonStyle}"
                                                    Command="{Binding DataContext.WakeSelectedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="Send Wake-on-LAN (WoL)" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Profile & Metadata -->
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="ALIAS &amp; CATEGORY" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                            <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                                     Text="{Binding CustomNickname, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,5"
                                                     Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Category}"
                                                      Height="30" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Traffic Totals -->
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                                <TextBlock Text="SESSION" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding SessionTotalText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" HorizontalAlignment="Right">
                                                <TextBlock Text="TODAY" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding TodayUsageText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource RxAccentBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0">
                                                <TextBlock Text="7 DAYS" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding WeekUsageText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TxAccentBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="30 DAYS" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding MonthUsageText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource HealthyAccentBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding ProtocolBreakdownText}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,6,0,0" />
                                        </Grid>
                                    </Border>

                                    <!-- Bandwidth Limits & Device Presets -->
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="BANDWIDTH LIMITS &amp; QUOTA" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="DL Cap (KB/s)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                                             Text="{Binding DownloadCapKBps, UpdateSourceTrigger=LostFocus}"
                                                             IsEnabled="{Binding CanThrottle}"
                                                             FontFamily="{StaticResource MonoFont}"
                                                             KeyDown="CapTextBox_KeyDown"
                                                             LostFocus="CapTextBox_LostFocus" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="UL Cap (KB/s)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                                             Text="{Binding UploadCapKBps, UpdateSourceTrigger=LostFocus}"
                                                             IsEnabled="{Binding CanThrottle}"
                                                             FontFamily="{StaticResource MonoFont}"
                                                             KeyDown="CapTextBox_KeyDown"
                                                             LostFocus="CapTextBox_LostFocus" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Daily Quota (MB, 0 = off)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Style="{StaticResource DarkTextBoxStyle}"
                                                         Text="{Binding DailyQuotaMB, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CanThrottle}"
                                                         FontFamily="{StaticResource MonoFont}"
                                                         Margin="0,0,6,0" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource GlassChipButtonStyle}"
                                                        Command="{Binding ClearCapsCommand}"
                                                        Content="Reset" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding DataContext.Presets, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                                                Content="{Binding Name}"
                                                                ToolTip="{Binding Description}"
                                                                Command="{Binding DataContext.ApplyPresetToSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0,0,5,5" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Per-Device DNS Sinkhole -->
                                    <StackPanel>
                                        <TextBlock Text="PER-DEVICE DOMAIN BLOCKLIST" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Style="{StaticResource DarkTextBoxStyle}"
                                                     Text="{Binding DataContext.NewDomainInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,4"
                                                     Margin="0,0,6,0" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource DangerChipButtonStyle}"
                                                    Command="{Binding DataContext.AddBlockedDomainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="Block" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding BlockedDomains}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource GlassPillBadgeStyle}" Margin="0,0,0,4" Padding="9,4">
                                                        <Grid>
                                                            <TextBlock Text="{Binding}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                            <Button Style="{StaticResource GlassChipButtonStyle}"
                                                                    HorizontalAlignment="Right"
                                                                    Padding="7,1"
                                                                    Content="×"
                                                                    Command="{Binding DataContext.RemoveBlockedDomainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- #############################################################
                     SECTION 2: APP & WEBSITE MONITOR (GlassWire-Inspired View)
                     ############################################################# -->
                <Grid Visibility="{Binding IsAppMonitorSection, Converter={StaticResource BoolToVis}}">
                    <views:AppMonitorView DataContext="{Binding AppMonitor}" />
                </Grid>

                <!-- #############################################################
                     SECTION 3: TOPOLOGY & SECURITY
                     ############################################################# -->
                <Grid Visibility="{Binding IsTopologySecuritySection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.15*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Interactive Network Radar Topology Canvas -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FrostedGlassCardStyle}"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,0,10,10">
                        <controls:NetworkTopologyControl Devices="{Binding FilteredDevices}"
                                                         SelectedDevice="{Binding SelectedDevice, Mode=TwoWay}" />
                    </Border>

                    <!-- Dual Ring Gauge + Selected Node HUD + Aggregate Sparkline -->
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource FrostedGlassCardStyle}"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="TELEMETRY GAUGE &amp; NODE HUD"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            Content="Clear Node"
                                            Click="OnDismissTopologyHudClicked"
                                            Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:DualRingGaugeControl Grid.Column="0"
                                                               Width="148"
                                                               Height="148"
                                                               DownloadRatio="{Binding SelectedDevice.DownloadBarRatio, FallbackValue=0}"
                                                               UploadRatio="{Binding SelectedDevice.UploadBarRatio, FallbackValue=0}"
                                                               CenterGlyph="{Binding SelectedDevice.CategoryIconGlyph, FallbackValue=LAN}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            DataContext="{Binding SelectedDevice}">
                                    <TextBlock Text="{Binding DisplayName, FallbackValue='Select a host node on the radar'}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding IpAddressText, FallbackValue='No active node inspected'}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource ActiveAccentBrush}"
                                               Margin="0,2,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="RX " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding DownloadSpeedText, FallbackValue='0 KB/s'}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource RxAccentBrush}"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Text="TX " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding UploadSpeedText, FallbackValue='0 KB/s'}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TxAccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Ping " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding PingLatencyText, FallbackValue='—'}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource HealthyAccentBrush}"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding StatusBadgeText, FallbackValue=''}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrush}, FallbackValue=Transparent}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Vendor, FallbackValue=''}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ProtocolBreakdownText, FallbackValue=''}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="AGGREGATE LAN PULSE (RX / TX)"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <controls:SparklineControl Height="34"
                                                           PrimarySeries="{Binding NetworkDownloadSeries}"
                                                           SecondarySeries="{Binding NetworkUploadSeries}"
                                                           ShowGridLines="True" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ARP Security Guard Feed -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FrostedGlassCardStyle}"
                            CornerRadius="14"
                            Padding="0"
                            Margin="0,0,10,0">
                        <Grid themes:ThemeManager.ClipCornerRadius="{StaticResource RadiusCardClipValue}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                                <Grid>
                                    <TextBlock Text="ARP SECURITY GUARD"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right"
                                            CornerRadius="10"
                                            Padding="9,2"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource HealthySurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource HealthyAccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsArpAlertActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerAccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ArpGuardStatusText}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource FramelessDataGridStyle}"
                                      ItemsSource="{Binding SecurityAlerts}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="36">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" Width="80" FontFamily="{StaticResource MonoFont}" />
                                    <DataGridTextColumn Header="Target IP" Binding="{Binding TargetIp}" Width="110" FontFamily="{StaticResource MonoFont}" />
                                    <DataGridTextColumn Header="Expected MAC" Binding="{Binding ExpectedMac}" Width="130" FontFamily="{StaticResource MonoFont}" />
                                    <DataGridTextColumn Header="Offending MAC" Binding="{Binding OffendingMac}" Width="130" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource DangerAccentBrush}" />
                                    <DataGridTextColumn Header="Details" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="1"
                                       Text="ARP Security Guard active — zero spoofing anomalies observed."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SecurityAlerts.Count, Converter={StaticResource CountZeroToVis}}" />
                        </Grid>
                    </Border>

                    <!-- Live DNS Sinkhole & Query Log -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource FrostedGlassCardStyle}"
                            CornerRadius="14"
                            Padding="0">
                        <Grid themes:ThemeManager.ClipCornerRadius="{StaticResource RadiusCardClipValue}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                                <Grid>
                                    <TextBlock Text="LIVE DNS SINKHOLE &amp; QUERIES"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource DangerChipButtonStyle}"
                                                Command="{Binding BlockSelectedDnsDomainCommand}"
                                                Margin="0,0,6,0"
                                                Content="Block Selected" />
                                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                                Command="{Binding ClearDnsLogsCommand}"
                                                Content="Clear" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource FramelessDataGridStyle}"
                                      ItemsSource="{Binding DnsQueryLogs}"
                                      SelectedItem="{Binding SelectedDnsRecord, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="36">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" Width="74" FontFamily="{StaticResource MonoFont}" />
                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="120" />
                                    <DataGridTextColumn Header="IP" Binding="{Binding DeviceIp}" Width="105" FontFamily="{StaticResource MonoFont}" />
                                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource WebMonitorAccentBrush}" />
                                    <DataGridTextColumn Header="Blocked" Binding="{Binding WasBlocked}" Width="66" FontFamily="{StaticResource MonoFont}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="1"
                                       Text="DNS query stream populates while LAN traffic is redirected."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding DnsQueryLogs.Count, Converter={StaticResource CountZeroToVis}}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- #############################################################
                     SECTION 4: HISTORY & POLICIES (Usage History + DPI Analytics + Smart Schedules)
                     ############################################################# -->
                <Grid Visibility="{Binding IsHistoryPoliciesSection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.15*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Range Selector & Aggregates Toolbar -->
                    <Border Grid.Row="0"
                            Style="{StaticResource FrostedGlassCardStyle}"
                            CornerRadius="12"
                            Padding="12,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource ControlFillBrush}"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="13"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            themes:ThemeManager.IsActive="{Binding SelectedHistoryRange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Today}"
                                            Command="{Binding SelectHistoryRangeCommand}"
                                            CommandParameter="Today"
                                            Padding="11,4"
                                            Content="Today (24h)" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            themes:ThemeManager.IsActive="{Binding SelectedHistoryRange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Past7Days}"
                                            Command="{Binding SelectHistoryRangeCommand}"
                                            CommandParameter="Past7Days"
                                            Margin="3,0,0,0"
                                            Padding="11,4"
                                            Content="Past 7 Days" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            themes:ThemeManager.IsActive="{Binding SelectedHistoryRange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Past30Days}"
                                            Command="{Binding SelectHistoryRangeCommand}"
                                            CommandParameter="Past30Days"
                                            Margin="3,0,0,0"
                                            Padding="11,4"
                                            Content="Past 30 Days" />
                                    <Button Style="{StaticResource GlassChipButtonStyle}"
                                            themes:ThemeManager.IsActive="{Binding SelectedHistoryRange, Converter={StaticResource StringEqualsConverter}, ConverterParameter=AllTime}"
                                            Command="{Binding SelectHistoryRangeCommand}"
                                            CommandParameter="AllTime"
                                            Margin="3,0,0,0"
                                            Padding="11,4"
                                            Content="All-Time" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                <Border Style="{StaticResource GlassPillBadgeStyle}" Margin="0,0,6,0" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Total " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding HistoryGrandTotalText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassPillBadgeStyle}" Margin="0,0,6,0" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="RX " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding HistoryTotalDownloadText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource RxAccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassPillBadgeStyle}" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TX " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding HistoryTotalUploadText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TxAccentBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GlassChipButtonStyle}"
                                        Command="{Binding RefreshHistoryCommand}"
                                        Margin="0,0,6,0"
                                        Content="Refresh" />
                                <Button Style="{StaticResource GlassChipButtonStyle}"
                                        Command="{Binding ExportHistoryCsvCommand}"
                                        Margin="0,0,6,0"
                                        Content="Export CSV" />
                                <Button Style="{StaticResource DangerChipButtonStyle}"
                                        Command="{Binding ClearHistoryCommand}"
                                        Content="Purge History" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Usage Bar Chart + Usage History Ledger -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource FrostedGlassCardStyle}"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="DAILY BANDWIDTH BREAKDOWN"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text=" · "
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedHistoryRangeTitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ActiveAccentBrush}" />
                                </StackPanel>
                                <controls:UsageBarChartControl Grid.Row="1"
                                                               Series="{Binding SelectedHistoryDeviceSeries}" />
                            </Grid>
                        </Border>

                        <!-- Fixed DeviceUsageSummary bindings (DisplayName, LastKnownIp, MacAddress, TotalFormatted, DownloadFormatted, UploadFormatted, ShareFormatted) -->
                        <Border Grid.Column="1"
                                Style="{StaticResource FrostedGlassCardStyle}"
                                CornerRadius="14"
                                Padding="0">
                            <Grid themes:ThemeManager.ClipCornerRadius="{StaticResource RadiusCardClipValue}">
                                <DataGrid Style="{StaticResource FramelessDataGridStyle}"
                                          ItemsSource="{Binding HistoryDeviceSummaries}"
                                          SelectedItem="{Binding SelectedHistoryDevice, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="38">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Host" Binding="{Binding DisplayName}" Width="1.3*" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="IPv4" Binding="{Binding LastKnownIp}" Width="115" FontFamily="{StaticResource MonoFont}" />
                                        <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="132" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextMutedBrush}" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalFormatted}" Width="88" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="RX" Binding="{Binding DownloadFormatted}" Width="88" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource RxAccentBrush}" />
                                        <DataGridTextColumn Header="TX" Binding="{Binding UploadFormatted}" Width="88" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TxAccentBrush}" />
                                        <DataGridTextColumn Header="Share" Binding="{Binding ShareFormatted}" Width="74" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource WarnAccentBrush}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="No historical usage samples stored yet for this time range."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding HistoryDeviceSummaries.Count, Converter={StaticResource CountZeroToVis}}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 2: Protocol Analytics (DPI) + Autonomous Smart Schedules -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>

                        <!-- Protocol Analytics Card -->
                        <Border Grid.Column="0"
                                Style="{StaticResource FrostedGlassCardStyle}"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="DEEP PACKET INSPECTION · PROTOCOL ANALYTICS"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,10" />
                                <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,1" Padding="10,8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="HTTP / TLS" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding ProtoHttpTlsSummary}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource RxAccentBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="TCP STREAMS" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding ProtoTcpSummary}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource HealthyAccentBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0" Padding="10,8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="UDP / QUIC" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding ProtoUdpSummary}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WarnAccentBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="14,8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="DNS LOOKUPS" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding ProtoDnsSummary}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TxAccentBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Autonomous Smart Schedules Card -->
                        <Border Grid.Column="1"
                                Style="{StaticResource FrostedGlassCardStyle}"
                                CornerRadius="14"
                                Padding="0">
                            <Grid themes:ThemeManager.ClipCornerRadius="{StaticResource RadiusCardClipValue}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                                    <Grid>
                                        <TextBlock Text="AUTONOMOUS SMART SCHEDULES"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Style="{StaticResource GlassChipButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Command="{Binding ResetSmartRulesCommand}"
                                                Content="Reset Defaults" />
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SmartRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Style="{StaticResource GlassPillBadgeStyle}"
                                                                Padding="8,2"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RuleType}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ActiveAccentBrush}" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12.5"
                                                                           Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding StatusDescription}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource WarnAccentBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                                            <TextBlock Text="{Binding TargetCategory}"
                                                                       FontSize="11"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding ThrottleCapKBps, StringFormat={}{0} KB/s}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource WarnAccentBrush}" />
                                                        </StackPanel>

                                                        <Button Grid.Column="3"
                                                                Style="{StaticResource GlassChipButtonStyle}"
                                                                themes:ThemeManager.IsActive="{Binding IsEnabled}"
                                                                Command="{Binding DataContext.ToggleSmartRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                MinWidth="76"
                                                                VerticalAlignment="Center">
                                                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="ENABLED" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                <Setter Property="Text" Value="DISABLED" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- =================================================================
                 ROW 3: SLIM FROSTED STATUS BAR
                 ================================================================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource GlassSurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource GlassSpecularRimBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="12,0,12,10"
                    Padding="12,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="520"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalSpeedTickerText}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeakDownloadText}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SessionTotalText}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DriverStatusText}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource HealthyAccentBrush}"
                                   Margin="0,0,14,0"
                                   VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                  Content="Close to tray"
                                  FontSize="11"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
