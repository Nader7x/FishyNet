<Window x:Class="FishyNet.Views.MiniHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FishyNet Mini HUD"
        Width="760"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border x:Name="CapsuleBorder"
            Background="{DynamicResource GlassSurfaceElevatedBrush}"
            BorderBrush="{DynamicResource GlassSpecularRimBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="14,6"
            MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
            Cursor="SizeAll">

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- Brand & HUD Pill -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <!-- Divider -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <!-- Download -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <!-- Upload -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <!-- Ping -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <!-- Hosts -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- Boost Pill & Actions -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Capsule Identity -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="7"
                        Height="7"
                        CornerRadius="999"
                        Background="{DynamicResource HealthyAccentBrush}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                <TextBlock Text="FISHYNET"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Border Background="{DynamicResource ControlFillBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="999"
                        Padding="7,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="HUD"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ActiveAccentBrush}" />
                </Border>
            </StackPanel>

            <!-- Subtle Hairline Divider -->
            <Border Grid.Column="2"
                    Width="1"
                    Height="18"
                    Background="{DynamicResource SubtleBorderBrush}"
                    VerticalAlignment="Center" />

            <!-- Live LAN Download -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="RX "
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalDownloadText}"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource RxAccentBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Live LAN Upload -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="TX "
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalUploadText}"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TxAccentBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Gateway Ping RTT -->
            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="RTT "
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding GatewayLatencyText}"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource HealthyAccentBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Hosts Count -->
            <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="HOSTS "
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding OnlineDevicesCount}"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right Controls: Glowing Boost Pill, Dashboard & Close Capsule Buttons -->
            <StackPanel Grid.Column="12" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleGamingBoostCommand}"
                        Height="28"
                        Margin="0,0,6,0"
                        Cursor="Hand"
                        ToolTip="1-Click Gaming Priority: Throttles all other background devices to 64 KB/s">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource RxAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource RxAccentBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="12,3" />
                            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BoostBd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="14"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoostBd" Property="Background" Value="{DynamicResource GlassSurfaceHoverBrush}" />
                                                <Setter TargetName="BoostBd" Property="BorderBrush" Value="{DynamicResource ActiveAccentBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsGamingBoostActive}" Value="True">
                                                <Setter TargetName="BoostBd" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FBBF24" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGamingBoostActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WarnSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarnAccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource WarnAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding GamingBoostButtonText}" />
                </Button>

                <Button Content="DASHBOARD"
                        Click="OnRestoreFullWindowClicked"
                        Style="{DynamicResource GlassPillButtonStyle}"
                        Height="28"
                        Padding="12,3"
                        FontSize="11"
                        FontFamily="{DynamicResource MonoFont}"
                        Margin="0,0,6,0"
                        Cursor="Hand"
                        ToolTip="Restore main engineering console" />

                <Button Content="✕"
                        Click="OnCloseHudClicked"
                        Width="28"
                        Height="28"
                        FontSize="11"
                        FontFamily="{DynamicResource MonoFont}"
                        Cursor="Hand"
                        ToolTip="Close Mini HUD">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBd" Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                <Setter TargetName="CloseBd" Property="BorderBrush" Value="{DynamicResource DangerAccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
