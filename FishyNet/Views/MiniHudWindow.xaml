<Window x:Class="FishyNet.Views.MiniHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FishyNet Mini HUD"
        Width="640"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource CanvasBgBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border Background="{StaticResource SurfaceBgBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            Padding="8,2"
            MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
            Cursor="SizeAll">

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- Brand & Drag Handle -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <!-- Download -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <!-- Upload -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <!-- Ping -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <!-- Online hosts -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- Boost Button & Actions -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Drag Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#111317" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="4,1" Margin="0,0,6,0">
                    <TextBlock Text="HUD" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                </Border>
                <TextBlock Text="FISHYNET" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Live LAN Download -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="RX " FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalDownloadText}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Live LAN Upload -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="TX " FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalUploadText}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Gateway Ping RTT -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="4" Background="{StaticResource AccentEmeraldBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock Text="RTT " FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GatewayLatencyText}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Hosts Count -->
            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="HOSTS: " FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OnlineDevicesCount}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right Controls: Boost Button & Full Dashboard Toggle -->
            <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 1-Click Gaming Boost Toggle Button -->
                <Button Command="{Binding ToggleGamingBoostCommand}"
                        Padding="6,1"
                        Margin="0,0,4,0"
                        FontSize="9.5"
                        FontFamily="{StaticResource MonoFont}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        ToolTip="1-Click Gaming Priority: Throttles all other background devices to 64 KB/s">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background" Value="#181B21" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentSkyBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentSkyBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGamingBoostActive}" Value="True">
                                    <Setter Property="Background" Value="#3B230B" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                    <Setter Property="Foreground" Value="#FEF08A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding GamingBoostButtonText}" />
                </Button>

                <!-- Restore Full App -->
                <Button Content="DASHBOARD"
                        Click="OnRestoreFullWindowClicked"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="20"
                        Padding="5,1"
                        FontSize="9"
                        FontFamily="{StaticResource MonoFont}"
                        Margin="0,0,3,0"
                        Cursor="Hand"
                        ToolTip="Restore main engineering console" />

                <!-- Close HUD -->
                <Button Content="[X]"
                        Click="OnCloseHudClicked"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="20"
                        Padding="4,1"
                        FontSize="9"
                        FontFamily="{StaticResource MonoFont}"
                        Cursor="Hand"
                        ToolTip="Close Mini HUD" />
            </StackPanel>
        </Grid>
    </Border>
</Window>