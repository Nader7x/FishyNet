                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="NormalText" Property="Opacity" Value="1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="BlackoutLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="NormalText" Property="Opacity" Value="0.35" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DayBd" Property="Opacity" Value="0.35" />
