<Window x:Class="SelfishNetv3.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SelfishNetv3.Controls"
        xmlns:vm="clr-namespace:SelfishNetv3.ViewModels"
        Title="SelfishNet v3 — LAN Bandwidth Shaper &amp; Usage Telemetry"
        Width="1480"
        Height="870"
        MinWidth="1160"
        MinHeight="680"
        Background="#CC070A10"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource SansFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Subtle Ambient Radial Frost Glow Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E6070A10" Offset="0.0" />
                <GradientStop Color="#D90B111C" Offset="0.45" />
                <GradientStop Color="#E6070A11" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!-- Top Navigation & Adapter Control Bar -->
            <RowDefinition Height="Auto" />
            <!-- Live Telemetry Strip -->
            <RowDefinition Height="Auto" />
            <!-- Main Workspace & Inspector Drawer -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Footer -->
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- 1. TOP FROSTED COMMAND BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBgBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#121C2C" BorderBrush="#263B59" BorderThickness="1" CornerRadius="3" Padding="3" Margin="0,0,10,0">
                        <Image x:Name="BrandLogoImage" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SELFISHNET" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#142E28" BorderBrush="#10B981" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v3.2" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Zero-Alloc Packet Shaper &amp; LAN Telemetry" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Network Interface Selector -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="ACTIVE NETWORK INTERFACE (NIC)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding Adapters}"
                              SelectedItem="{Binding SelectedAdapter}"
                              Height="28"
                              FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text=" · " Foreground="#64748B" />
                                    <TextBlock Text="{Binding LocalIp}" FontFamily="{StaticResource MonoFont}" Foreground="#38BDF8" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Primary Action Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Scan Subnet"
                            Command="{Binding ScanSubnetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Send ARP probes across the local CIDR subnet to discover connected devices" />

                    <Button Content="{Binding RedirectionButtonText}"
                            Command="{Binding ToggleRedirectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Start or stop ARP redirection and Token-Bucket bandwidth shaping" />

                    <Button Content="Monitor All"
                            Command="{Binding MonitorAllCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Switch all bypassed LAN devices back to MONITORED state (active traffic redirection)" />

                    <Button Content="Bypass All (Restore ARP)"
                            Command="{Binding UnspoofAllCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Switch all LAN devices to BYPASSED state, clear caps, and restore original gateway MAC tables" />
                </StackPanel>

                <!-- Right Utility Controls (Friendly Unit Mode Toggle + Background Tray Toggle) -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="{Binding UnitModeButtonText}"
                            Command="{Binding ToggleUnitModeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,14,0"
                            ToolTip="Switch speed representations between Bytes/sec (KB/s, MB/s) and ISP Bits/sec (Kbps, Mbps)" />

                    <CheckBox Content="Run in Tray on Close"
                              IsChecked="{Binding CloseToTray}"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              ToolTip="When checked, closing or minimizing the window keeps SelfishNet running in the Windows System Tray" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. TOP FROSTED TELEMETRY STRIP -->
        <Border Grid.Row="1"
                Background="#990A0F18"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188" />
                    <ColumnDefinition Width="188" />
                    <ColumnDefinition Width="182" />
                    <ColumnDefinition Width="205" />
                    <ColumnDefinition Width="188" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Live Download Metric -->
                <Border Grid.Column="0" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                    <Grid>
                        <Border Height="2" VerticalAlignment="Top" Background="{StaticResource AccentSkyBrush}" CornerRadius="2,2,0,0" />
                        <StackPanel Margin="12,8,12,7">
                            <TextBlock Text="LAN DOWNLOAD RATE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalDownloadText}" FontFamily="{StaticResource MonoFont}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" Margin="0,2,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Peak: " FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding PeakDownloadText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Live Upload Metric -->
                <Border Grid.Column="1" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                    <Grid>
                        <Border Height="2" VerticalAlignment="Top" Background="{StaticResource AccentVioletBrush}" CornerRadius="2,2,0,0" />
                        <StackPanel Margin="12,8,12,7">
                            <TextBlock Text="LAN UPLOAD RATE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalUploadText}" FontFamily="{StaticResource MonoFont}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" Margin="0,2,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Session: " FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SessionTotalText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Connected Hosts Summary -->
                <Border Grid.Column="2" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                    <Grid>
                        <Border Height="2" VerticalAlignment="Top" Background="{StaticResource AccentAmberBrush}" CornerRadius="2,2,0,0" />
                        <StackPanel Margin="12,8,12,7">
                            <TextBlock Text="DISCOVERED HOSTS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding OnlineDevicesCount}" FontFamily="{StaticResource MonoFont}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Capped: " FontSize="10.5" Foreground="{StaticResource AccentAmberBrush}" />
                                <TextBlock Text="{Binding ThrottledDevicesCount}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource AccentAmberBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Blocked: " FontSize="10.5" Foreground="{StaticResource AccentCrimsonBrush}" />
                                <TextBlock Text="{Binding BlockedDevicesCount}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource AccentCrimsonBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Gateway & ARP Guard Health -->
                <Border Grid.Column="3" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                    <Grid>
                        <Border Height="2" VerticalAlignment="Top" Background="{StaticResource AccentEmeraldBrush}" CornerRadius="2,2,0,0" />
                        <StackPanel Margin="12,8,12,7">
                            <TextBlock Text="GATEWAY &amp; SECURITY" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                <TextBlock Text="Ping RTT: " FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GatewayLatencyText}" FontFamily="{StaticResource MonoFont}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ArpGuardStatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Historical 7-Day Quick Summary -->
                <Border Grid.Column="4" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                    <Grid>
                        <Border Height="2" VerticalAlignment="Top" Background="#38BDF8" CornerRadius="2,2,0,0" />
                        <StackPanel Margin="12,8,12,7">
                            <TextBlock Text="RECORDED USAGE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding HistoryGrandTotalText}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,2" />
                            <TextBlock Text="{Binding SelectedHistoryRangeTitle}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Live 60s Dual Sparkline Chart -->
                <Border Grid.Column="5" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6">
                    <Grid>
                        <controls:SparklineControl PrimarySeries="{Binding NetworkDownloadSeries}"
                                                   SecondarySeries="{Binding NetworkUploadSeries}"
                                                   ShowGridLines="True" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0">
                            <Border Width="7" Height="7" CornerRadius="1.5" Background="{StaticResource AccentSkyBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="Down" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" />
                            <Border Width="7" Height="7" CornerRadius="1.5" Background="{StaticResource AccentVioletBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="Up (60s)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3. MAIN WORKSPACE AREA -->
        <Grid Grid.Row="2" Margin="16,10,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left/Center Tabbed Workspace -->
            <TabControl Grid.Column="0" SelectedIndex="{Binding ActiveWorkspaceTab}">

                <!-- TAB 1: LIVE DEVICES & BANDWIDTH SHAPER -->
                <TabItem Header="Live Devices &amp; Bandwidth Control">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Filter, Status Pills & Quick LAN Preset Bar -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="10,7" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         ToolTip="Search by Device Name, IP, MAC Address, or OUI Manufacturer" />

                                <!-- Quick Status Filter Pills -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="All" Command="{Binding SetStatusFilterCommand}" CommandParameter="All" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,4,0" />
                                    <Button Content="Active" Command="{Binding SetStatusFilterCommand}" CommandParameter="Active" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,4,0" />
                                    <Button Content="Throttled" Command="{Binding SetStatusFilterCommand}" CommandParameter="Throttled" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,4,0" />
                                    <Button Content="Blocked" Command="{Binding SetStatusFilterCommand}" CommandParameter="Blocked" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,4,0" />
                                    <Button Content="Bypassed" Command="{Binding SetStatusFilterCommand}" CommandParameter="Bypassed" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" />
                                </StackPanel>

                                <!-- Quick LAN Presets -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="LAN Preset:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ItemsControl ItemsSource="{Binding Presets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}"
                                                        Command="{Binding DataContext.ApplyPresetToAllLanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8,3"
                                                        FontSize="10.5"
                                                        Margin="0,0,4,0"
                                                        ToolTip="{Binding Description}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Button Grid.Column="6"
                                        Content="Export CSV"
                                        Command="{Binding ExportDevicesCsvCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="9,3"
                                        FontSize="11" />
                            </Grid>
                        </Border>

                        <!-- Devices DataGrid (Proportional Star Columns = Zero Horizontal Scrollbar!) -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding FilteredDevices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  IsReadOnly="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Toggle Monitored / Bypassed State" Command="{Binding ToggleMonitoredCommand}" FontWeight="SemiBold" />
                                                <MenuItem Header="Set Monitored (Redirect ARP)" Command="{Binding MonitorDeviceCommand}" />
                                                <MenuItem Header="Set Bypassed (Direct to Router)" Command="{Binding BypassDeviceCommand}" />
                                                <Separator />
                                                <MenuItem Header="Clear Caps &amp; Unblock (Full Speed)" Command="{Binding ClearCapsCommand}" />
                                                <MenuItem Header="Send Wake-on-LAN (WoL) Magic Packet" Command="{Binding DataContext.WakeSelectedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Separator />
                                                <MenuItem Header="Copy IPv4 Address" Command="{Binding CopyIpCommand}" />
                                                <MenuItem Header="Copy MAC Address" Command="{Binding CopyMacCommand}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Interactive Status Badge (Click to toggle BYPASSED <-> MONITORED) -->
                                <DataGridTemplateColumn Header="State" Width="90" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding ToggleMonitoredCommand}"
                                                    Cursor="Hand"
                                                    ToolTip="Click to toggle device between MONITORED (redirected) and BYPASSED (direct to router)"
                                                    HorizontalAlignment="Left"
                                                    Padding="0"
                                                    BorderThickness="0"
                                                    Background="Transparent">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BadgeBorder"
                                                                Background="#141E2E"
                                                                BorderBrush="#293B54"
                                                                BorderThickness="1"
                                                                CornerRadius="2.5"
                                                                Padding="6,2.5">
                                                            <TextBlock Text="{Binding StatusBadgeText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding StatusColorHex}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BadgeBorder" Property="Background" Value="#1E2D44" />
                                                                <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#38BDF8" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Device Name & Vendor -->
                                <DataGridTemplateColumn Header="Device &amp; Manufacturer" Width="1.45*" MinWidth="145" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RoleBadgeText}" FontSize="9.5" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Bold" />
                                                    <TextBlock Text=" · " FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Vendor}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- IPv4 & MAC -->
                                <DataGridTemplateColumn Header="IPv4 / MAC" Width="134" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding IpAddressText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding MacAddressText}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Friendly Download Speed + Visual Bar + % of Cap -->
                                <DataGridTemplateColumn Header="Download Rate" Width="1.15*" MinWidth="122" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding DownloadSpeedText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" />
                                                    <TextBlock Text="{Binding DownloadCapStatusText}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <ProgressBar Value="{Binding DownloadBarRatio, Mode=OneWay}"
                                                             Minimum="0" Maximum="1"
                                                             Height="3.5"
                                                             Margin="0,3,0,0"
                                                             Foreground="{StaticResource AccentSkyBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Friendly Upload Speed + Visual Bar + % of Cap -->
                                <DataGridTemplateColumn Header="Upload Rate" Width="1.15*" MinWidth="122" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding UploadSpeedText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" />
                                                    <TextBlock Text="{Binding UploadCapStatusText}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <ProgressBar Value="{Binding UploadBarRatio, Mode=OneWay}"
                                                             Minimum="0" Maximum="1"
                                                             Height="3.5"
                                                             Margin="0,3,0,0"
                                                             Foreground="{StaticResource AccentVioletBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Per-Row 30s Sparkline -->
                                <DataGridTemplateColumn Header="30s Trend" Width="74" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:SparklineControl PrimarySeries="{Binding SparklineSeries}" Height="24" Margin="1,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Inline Editable Download Cap (KB/s) -->
                                <DataGridTemplateColumn Header="Down Cap" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DownloadCapKBps, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanThrottle}"
                                                     Style="{StaticResource DarkTextBoxStyle}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="11.5"
                                                     Padding="5,2"
                                                     TextAlignment="Right"
                                                     ToolTip="Download cap in KB/s (0 = Unlimited)" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Inline Editable Upload Cap (KB/s) -->
                                <DataGridTemplateColumn Header="Up Cap" Width="78">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UploadCapKBps, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanThrottle}"
                                                     Style="{StaticResource DarkTextBoxStyle}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="11.5"
                                                     Padding="5,2"
                                                     TextAlignment="Right"
                                                     ToolTip="Upload cap in KB/s (0 = Unlimited)" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 7-Day & 30-Day Friendly Usage Column -->
                                <DataGridTemplateColumn Header="7d / 30d Usage" Width="106" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="7d: " FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding WeekUsageText}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="30d: " FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding MonthUsageText}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Ping Latency -->
                                <DataGridTextColumn Header="Ping"
                                                    Binding="{Binding PingLatencyText}"
                                                    Width="54"
                                                    FontFamily="{StaticResource MonoFont}"
                                                    FontSize="11"
                                                    IsReadOnly="True" />

                                <!-- Block Checkbox -->
                                <DataGridTemplateColumn Header="Block" Width="46">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanThrottle}"
                                                      ToolTip="Kill-Switch: Drop all packets for this device"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Monitor / Bypass Checkbox -->
                                <DataGridTemplateColumn Header="Monitor" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSpoofed, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanThrottle}"
                                                      ToolTip="Checked = MONITORED (traffic redirected through SelfishNet). Unchecked = BYPASSED (direct to router)."
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: HISTORICAL USAGE (TODAY / PAST WEEK / PAST MONTH / ALL-TIME) -->
                <TabItem Header="Usage History (Week / Month)">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="215" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Range Selector & Export Controls -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Time Window:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="Today (24h)" Command="{Binding SelectHistoryRangeCommand}" CommandParameter="Today" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" />
                                    <Button Content="Past 7 Days (Week)" Command="{Binding SelectHistoryRangeCommand}" CommandParameter="Past7Days" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" />
                                    <Button Content="Past 30 Days (Month)" Command="{Binding SelectHistoryRangeCommand}" CommandParameter="Past30Days" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" />
                                    <Button Content="All-Time" Command="{Binding SelectHistoryRangeCommand}" CommandParameter="AllTime" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Downloaded: " FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding HistoryTotalDownloadText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" Margin="0,0,12,0" />
                                    <TextBlock Text="Uploaded: " FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding HistoryTotalUploadText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" Margin="0,0,12,0" />
                                    <TextBlock Text="Total: " FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding HistoryGrandTotalText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Content="Export CSV Report" Command="{Binding ExportHistoryCsvCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                                    <Button Content="Reset History" Command="{Binding ClearHistoryCommand}" Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Daily Stacked Usage Bar Chart -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding SelectedHistoryRangeTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Width="9" Height="9" CornerRadius="1.5" Background="{StaticResource AccentSkyBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="Download Volume" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0" />
                                        <Border Width="9" Height="9" CornerRadius="1.5" Background="{StaticResource AccentVioletBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="Upload Volume (Hover bars for daily totals)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <controls:UsageBarChartControl Grid.Row="1" Series="{Binding SelectedHistoryDeviceSeries}" />
                            </Grid>
                        </Border>

                        <!-- Per-Device Historical Ranking Table -->
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding HistoryDeviceSummaries}"
                                  SelectedItem="{Binding SelectedHistoryDevice}"
                                  AutoGenerateColumns="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device Name" Binding="{Binding DisplayName}" Width="1.4*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="135" FontFamily="{StaticResource MonoFont}" />
                                <DataGridTextColumn Header="Last Known IP" Binding="{Binding LastKnownIp}" Width="115" FontFamily="{StaticResource MonoFont}" />
                                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Vendor}" Width="1.1*" />
                                <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadFormatted}" Width="105" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentSkyBrush}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Uploaded" Binding="{Binding UploadFormatted}" Width="105" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentVioletBrush}" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Total Data" Binding="{Binding TotalFormatted}" Width="115" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Bold" />
                                <DataGridTemplateColumn Header="Share of LAN Traffic" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ShareFormatted}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" />
                                                <ProgressBar Value="{Binding SharePercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" Margin="0,3,0,0" Foreground="{StaticResource AccentEmeraldBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Peak Speed" Binding="{Binding PeakDownloadFormatted}" Width="105" FontFamily="{StaticResource MonoFont}" />
                                <DataGridTextColumn Header="Active Days" Binding="{Binding ActiveDays}" Width="82" FontFamily="{StaticResource MonoFont}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 3: PROTOCOL & TRAFFIC ANALYTICS -->
                <TabItem Header="Protocol &amp; Traffic Analytics">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="215" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Protocol Breakdown Cards -->
                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="WEB / HTTPS / QUIC (443/80)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ProtoHttpTlsSummary}" FontFamily="{StaticResource MonoFont}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource AccentSkyBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TCP STREAMS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ProtoTcpSummary}" FontFamily="{StaticResource MonoFont}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="UDP / REALTIME / GAMING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ProtoUdpSummary}" FontFamily="{StaticResource MonoFont}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="DNS LOOKUPS (UDP 53)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ProtoDnsSummary}" FontFamily="{StaticResource MonoFont}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Large 60-Second Area Chart -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Real-Time 60-Second LAN Throughput (Download vs Upload)" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <controls:SparklineControl Grid.Row="1"
                                                           PrimarySeries="{Binding NetworkDownloadSeries}"
                                                           SecondarySeries="{Binding NetworkUploadSeries}"
                                                           ShowGridLines="True" />
                            </Grid>
                        </Border>

                        <!-- Per-Device Protocol & Session Breakdown -->
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  AutoGenerateColumns="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device" Binding="{Binding DisplayName}" Width="1.3*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddressText}" Width="120" FontFamily="{StaticResource MonoFont}" />
                                <DataGridTextColumn Header="Session Downloaded" Binding="{Binding SessionDownloadText}" Width="135" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentSkyBrush}" />
                                <DataGridTextColumn Header="Session Uploaded" Binding="{Binding SessionUploadText}" Width="135" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentVioletBrush}" />
                                <DataGridTextColumn Header="Session Total" Binding="{Binding SessionTotalText}" Width="125" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                                <DataGridTextColumn Header="Protocol Distribution" Binding="{Binding ProtocolBreakdownText}" Width="2*" FontFamily="{StaticResource MonoFont}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 4: DNS INSPECTOR & ARP SECURITY GUARD -->
                <TabItem Header="DNS Inspector &amp; ARP Guard">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="160" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Live Per-Device DNS Query Stream (Select a query to block that domain on the requesting device)" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Block Selected Domain on Device"
                                            Command="{Binding BlockSelectedDnsDomainCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Clear Log"
                                            Command="{Binding ClearDnsLogsCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DnsQueryLogs}"
                                  SelectedItem="{Binding SelectedDnsRecord}"
                                  AutoGenerateColumns="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  IsReadOnly="True"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" Width="95" FontFamily="{StaticResource MonoFont}" />
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="190" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Source IP" Binding="{Binding DeviceIp}" Width="125" FontFamily="{StaticResource MonoFont}" />
                                <DataGridTextColumn Header="Queried Domain" Binding="{Binding Domain}" Width="*" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentSkyBrush}" />
                                <DataGridTextColumn Header="Blocked" Binding="{Binding WasBlocked}" Width="85" FontFamily="{StaticResource MonoFont}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Passive ARP Spoof / MITM Guard Alerts" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,0,0,6" />
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding SecurityAlerts}"
                                          AutoGenerateColumns="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          IsReadOnly="True"
                                          RowHeight="32">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" Width="90" FontFamily="{StaticResource MonoFont}" />
                                        <DataGridTextColumn Header="Target IP" Binding="{Binding TargetIp}" Width="115" FontFamily="{StaticResource MonoFont}" />
                                        <DataGridTextColumn Header="Expected MAC" Binding="{Binding ExpectedMac}" Width="145" FontFamily="{StaticResource MonoFont}" />
                                        <DataGridTextColumn Header="Offending MAC" Binding="{Binding OffendingMac}" Width="145" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentCrimsonBrush}" />
                                        <DataGridTextColumn Header="Alert Details" Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Right Column: FROSTED DEVICE INSPECTOR & RULES DRAWER -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBgBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="13,12,7,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedDevice}" Margin="0,0,6,0">
                        <TextBlock Text="DEVICE INSPECTOR &amp; RULES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                        <TextBlock Text="{Binding DisplayName, FallbackValue='Select a device'}" FontSize="15.5" FontWeight="Bold" Margin="0,3,0,2" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding IpAddressText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentSkyBrush}" />
                            <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding MacAddressText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Monitoring State Control (Switch between Bypassed & Monitored) -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="REDIRECTION &amp; MONITOR MODE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Background="#141E2E" BorderBrush="#293B54" BorderThickness="1" CornerRadius="2.5" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusBadgeText}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StatusColorHex}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding MonitorModeDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Set Monitored"
                                            Command="{Binding MonitorDeviceCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="8,5"
                                            FontSize="11"
                                            ToolTip="Redirect this device's packets through SelfishNet to monitor speeds and enforce caps" />
                                    <Button Grid.Column="2"
                                            Content="Set Bypassed"
                                            Command="{Binding BypassDeviceCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,5"
                                            FontSize="11"
                                            ToolTip="Restore direct ARP to the router so this device bypasses SelfishNet" />
                                </Grid>
                                <CheckBox Content="Block All Internet Access (Kill-Switch)"
                                          IsChecked="{Binding IsBlocked, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanThrottle}"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Custom Nickname & Category -->
                        <TextBlock Text="Custom Friendly Nickname" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding CustomNickname, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Device Category" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding Category}"
                                  Height="28"
                                  Margin="0,0,0,10" />

                        <!-- Friendly Usage Summary Box -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="RECORDED DATA CONSUMPTION" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <Grid Margin="0,2">
                                    <TextBlock Text="Current Session:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SessionTotalText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Today (24h):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TodayUsageText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentSkyBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Past 7 Days (Week):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding WeekUsageText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentVioletBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Past 30 Days (Month):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding MonthUsageText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bandwidth Shaping & Daily Quota -->
                        <TextBlock Text="Token-Bucket Rate Limits &amp; Daily Quota" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Down Cap (KB/s)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding DownloadCapKBps, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanThrottle}"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Up Cap (KB/s)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding UploadCapKBps, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanThrottle}"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Daily Data Quota Limit (MB, 0 = Unlimited)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding DailyQuotaMB, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanThrottle}"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 FontFamily="{StaticResource MonoFont}"
                                 Margin="0,0,0,10" />

                        <!-- Wake-on-LAN Action -->
                        <Button Content="Send Wake-on-LAN (WoL) Packet"
                                Command="{Binding DataContext.WakeSelectedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,12" />

                        <!-- Per-Device Domain Blocker -->
                        <TextBlock Text="Blocked Domains (DNS Filter)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding DataContext.NewDomainInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     ToolTip="Enter a domain such as tiktok.com or youtube.com" />
                            <Button Grid.Column="2"
                                    Content="Block"
                                    Command="{Binding DataContext.AddBlockedDomainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding BlockedDomains}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#131C2B" BorderBrush="#243246" BorderThickness="1" CornerRadius="2.5" Padding="8,4" Margin="0,0,0,4">
                                        <Grid>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.RemoveBlockedDomainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="6,2"
                                                    FontSize="10"
                                                    HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. BOTTOM STATUS FOOTER -->
        <Border Grid.Row="3"
                Background="#E606090F"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="1.5" Background="{StaticResource AccentEmeraldBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding DriverStatusText}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
